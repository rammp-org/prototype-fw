# ESP32-P4 (the test stand's Waveshare ESP32-P4-ETH): the USB vendor / WebUSB +
# CDC transports use the native USB-OTG peripheral.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

# app_main keeps the services and the USB device on its stack, and the CANopen
# transactions log with fmt: well over the default.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Console on UART0: USB-Serial-JTAG shares the USB-C pads with the USB-OTG
# full-speed controller TinyUSB takes over for the console's interfaces.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# TinyUSB vendor (WebUSB) + CDC (Web Serial) class drivers; HID count only so
# the usb_device component's HID paths compile (no HID interface here).
CONFIG_TINYUSB_VENDOR_COUNT=1
CONFIG_TINYUSB_CDC_ENABLED=y
CONFIG_TINYUSB_CDC_COUNT=1
CONFIG_TINYUSB_HID_COUNT=1
CONFIG_TINYUSB_VENDOR_RX_BUFSIZE=2048
CONFIG_TINYUSB_VENDOR_TX_BUFSIZE=4096
CONFIG_TINYUSB_CDC_TX_BUFSIZE=4096

# C++
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# Standard USB services (system / monitor / OTA / core dump): the OTA+coredump
# partition layout (partitions.csv, 16 MB flash), core dumps to flash, OTA
# rollback, and the FreeRTOS run-time statistics the task monitor reads.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000
CONFIG_PARTITION_TABLE_MD5=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
